# ── Supabase ────────────────────────────────────────────────────────────────
# Create a project at https://supabase.com, then copy these from
# Project Settings → API. Put the real values in .env.local (gitignored).

# Safe to expose: shipped to the browser, limited by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=
# Dashboard label: "publishable key" (sb_publishable_...) on newer projects,
# or the legacy "anon / public" JWT. Either works — paste whichever you have.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. Bypasses every RLS policy — treat it like a root password.
# Never prefix with NEXT_PUBLIC_, never import into a client component.
# Dashboard label: "secret key" (sb_secret_...) on newer projects, or the
# legacy "service_role" JWT. Either works. This is the root-password one.
SUPABASE_SERVICE_ROLE_KEY=

# The single back-office account, created by `npm run seed`.
ADMIN_EMAIL=
# Read by the seed script only — never at runtime. Remove it once the
# account exists, or leave it blank and create the user in the Supabase UI.
ADMIN_PASSWORD=

# ── Not used yet ────────────────────────────────────────────────────────────
# Reserved so the shape is known; the Stripe and Resend work fills these in.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# RESEND_API_KEY=
